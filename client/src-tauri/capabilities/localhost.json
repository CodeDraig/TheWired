{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "localhost",
  "description": "Grants IPC access to the production asset origin (localhost.rs serves the bundle on a fixed port). Exactly that origin — any other local port is some other program and must never get IPC.",
  "remote": {
    "urls": ["http://localhost:14420"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "fs:allow-read-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://blossom.primal.net/**" },
        { "url": "https://cdn.satellite.earth/**" },
        { "url": "https://blossom.oxtr.dev/**" },
        { "url": "https://files.v0l.io/**" },
        { "url": "https://**" }
      ]
    }
  ]
}
