{
	# No admin API: nothing on the host or the Docker network should be able to
	# reload this config at runtime (localhost:2019 is the default otherwise).
	admin off
}

# Browser-facing response headers for every public host. `defer` applies them
# after the upstream answered, so an upstream value (helmet's X-Frame-Options
# SAMEORIGIN on the backend) is replaced rather than duplicated.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
		defer
	}
}

api.thewired.app {
	import security_headers

	# Multipart uploads stream files up to the backend's MAX_BLOB_SIZE; every
	# other API request is small JSON and gets a hard body cap at the edge
	# (the gateway applies the same cap with a 413, this stops the bytes sooner).
	@upload {
		path /upload /api/music/upload /api/music/upload/cover
	}
	handle @upload {
		reverse_proxy gateway:9080
	}
	handle {
		request_body {
			max_size 2MB
		}
		reverse_proxy gateway:9080
	}
}

# WebSocket hosts: no header snippet — the relay and LiveKit speak to native
# clients, and an HSTS/X-Frame-Options surprise there buys nothing.
relay.thewired.app {
	reverse_proxy relay:7777
}
livekit.thewired.app {
	reverse_proxy livekit:7880
}

thewired.app {
	import security_headers

	# The handles below reach the backend directly, not through the gateway. Only
	# the gateway may set these (after NIP-98 verification), so strip any a
	# client sends — the backend reads X-Auth-Pubkey as the caller's identity.
	request_header -X-Auth-Pubkey
	request_header -X-Client-Ip
	request_header -X-Gateway-Auth

	# NIP-05 identity verification — must be served from the root domain
	handle /.well-known/nostr.json {
		header Access-Control-Allow-Origin "*"
		reverse_proxy backend:3002
	}

	# Universal links (iOS) / App Links (Android) for the soot mobile app.
	# Apple fetches the AASA with no redirect allowed; both are JSON from backend.
	handle /.well-known/apple-app-site-association {
		reverse_proxy backend:3002
	}
	handle /.well-known/assetlinks.json {
		reverse_proxy backend:3002
	}

	# Server-rendered OG share pages for every path soot claims as a universal
	# link (backend routes/wellKnown.ts, pages in routes/linkPreview.ts). With
	# the app installed these open in-app; without it the visitor gets a "get
	# soot" page, never a 404. Read-only: the API lives on api.thewired.app,
	# behind the gateway.
	#
	# The matcher names the exact page shapes, because the backend mounts the
	# real music API under the same /music prefix: a bare `path /music/*` let
	# GET /music/browse, /music/tags/popular, /music/variants/<sha> and
	# /music/access/<pubkey>/<slug> through here, anonymously and with no
	# gateway rate limit. Shapes:
	#   /music/{track|album|playlist}/<64-hex pubkey>/<slug>   (one segment)
	#   /profile/<64-hex pubkey>
	#   /space/<id>[/…]           id: letters, digits, _ -
	#   /note/… /article/… /dm/… /invite/…
	@share {
		method GET HEAD
		path_regexp share ^/(?:music/(?:track|album|playlist)/[0-9a-f]{64}/[^/]+|profile/[0-9a-f]{64}|space/[A-Za-z0-9_-]+(?:/.*)?|(?:note|article|dm|invite)/.+)$
	}
	handle @share {
		reverse_proxy backend:3002
	}
	# Bare nostr entities at the root (thewired.app/npub1…): rewritten to the
	# backend's /e/<entity>, which keeps the original path as the canonical URL.
	@entity {
		path_regexp entity ^/((?:npub1|nprofile1|nevent1|naddr1|note1)[0-9a-z]+)$
		method GET HEAD
	}
	handle @entity {
		rewrite * /e/{re.entity.1}
		reverse_proxy backend:3002
	}

	# Landing page, incl. /terms, /community-guidelines, /privacy, /dmca, /support
	handle {
		reverse_proxy landing:8080
	}
}

# soot's own domains. soot.win is canonical; getsoot.app and the www names
# redirect to it. The legal and support pages live on thewired.app (one copy,
# generated from the app's own text) — the soot paths redirect there, so the
# App Store privacy and support URLs can sit on the app's domain.
soot.win {
	import security_headers
	redir /privacy https://thewired.app/privacy
	redir /terms https://thewired.app/terms
	redir /community-guidelines https://thewired.app/community-guidelines
	redir /dmca https://thewired.app/dmca
	redir /support https://thewired.app/support
	reverse_proxy landing:8080
}

www.soot.win, getsoot.app, www.getsoot.app {
	redir https://soot.win{uri} permanent
}
