GATEWAY_PORT=9080
BACKEND_URL=http://localhost:3002
REDIS_URL=redis://localhost:6380
RELAY_URL=ws://localhost:7777
LOG_LEVEL=debug

# Comma-separated browser origins allowed by CORS. Empty = none in production,
# "*" in dev (GATEWAY_ENV / NODE_ENV unset or not "production").
# ALLOWED_ORIGINS=https://thewired.app,tauri://localhost,http://localhost,https://tauri.localhost

# Set to "production" on a server. It flips the safe defaults: TRUSTED_PROXIES
# empty (trust nobody's X-Forwarded-*) and ALLOWED_ORIGINS deny-by-default.
# GATEWAY_ENV=production

# CIDRs / IPs whose X-Forwarded-For / X-Forwarded-Proto are believed. Dev
# default: the private ranges + loopback. Production default: empty — set it
# to the proxy's Docker subnet (e.g. `docker network inspect thewired_frontend`
# → 172.18.0.0/16) or Caddy's container IP, never a whole private range.
# TRUSTED_PROXIES=172.18.0.0/16

# Shared with the backend (same value in both containers): HMACs the forwarded
# X-Auth-Pubkey / X-Client-Ip into X-Gateway-Auth so the backend can verify
# they came from this gateway. Empty = header not sent (today's behaviour).
# openssl rand -hex 32
# GATEWAY_SHARED_SECRET=

# NIP-98 `payload` tag (sha256 of the request body) on body-bearing /api
# requests: off = verify only when present (default), warn = also log requests
# that omit it, enforce = 401 PAYLOAD_REQUIRED when it is missing. multipart
# uploads are exempt (a browser cannot hash a FormData body it has not built).
# NIP98_REQUIRE_PAYLOAD=off

# Rate limits, per minute unless noted.
# RATE_LIMIT_READ_PER_MIN=100          # per pubkey
# RATE_LIMIT_WRITE_PER_MIN=30          # per pubkey
# RATE_LIMIT_SEARCH_PER_MIN=10         # per pubkey
# RATE_LIMIT_MEDIA_PER_MIN=300         # per pubkey, play-time lookups
# RATE_LIMIT_IP_PER_MIN=1200           # per client IP, every /api request (0 = off)
# RATE_LIMIT_REPORT_ANON_PER_HOUR=5    # POST /api/reports, guests by IP
# RATE_LIMIT_REPORT_PER_HOUR=30        # POST /api/reports, by pubkey
# RATE_LIMIT_AUTH_FAIL_PER_MIN=60      # failed NIP-98 verifications per IP
# RATE_LIMIT_FAIL_MODE=open            # Redis down: open = let through, closed = 503
#                                      # (also governs the NIP-98 replay guard:
#                                      # closed = 503 on writes while Redis is down)

# Cap on JSON request bodies to /api (bytes). Upload routes are exempt.
# MAX_API_BODY_BYTES=2097152
